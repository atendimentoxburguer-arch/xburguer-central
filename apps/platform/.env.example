# Use a managed PostgreSQL database. Never put real credentials in Git.
DATABASE_URL=postgresql://xburguer:change-me@localhost:5432/xburguer
PUBLIC_ORIGIN=http://localhost:3080
HOST=127.0.0.1
PORT=3080
# Only used to create the first administrator in an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required in production, behind HTTPS; HTTP is allowed only on loopback.
NODE_ENV=development
# WhatsApp Business Platform (the mobile Business app alone does not provide these).
# Leave blank until configured. Never paste actual secrets into Git.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
